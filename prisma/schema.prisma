generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modelo de Categoría
model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(80)
  description String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relación 1:N con Productos (Una categoría tiene muchos productos)
  products    Product[]

  @@map("categories")
}
// Modelo de Marca
model Brand {
  id        Int       @id @default(autoincrement())
  name      String    @unique @db.VarChar(80)
  country   String?   @db.VarChar(60)
  website   String?   @db.VarChar(200)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relación 1:N con Productos (Una marca tiene muchos productos)
  products  Product[]

  @@map("brands")
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Float
  stock       Int
  sku         String   @unique
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relación con Categoría
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])

  // --- AGREGA ESTAS LÍNEAS PARA SOLUCIONAR EL ERROR ---
  
  // Relación N:1 con Marca (Opcional o obligatoria según tu caso)
  brandId     Int?
  brand       Brand?   @relation(fields: [brandId], references: [id])

  // Relación 1:N con Reseñas (Un producto tiene muchas reseñas)
  reviews     Review[]

  // --------------------------------------------------
}

// Modelo de Reseña
model Review {
  id        Int      @id @default(autoincrement())
  author    String   @db.VarChar(100)
  rating    Int
  comment   String   @db.VarChar(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relación N:1 con Producto (Cada reseña pertenece a un producto con borrado en cascada)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("reviews")
}
